# API
APP_NAME=resume-analyzer
DEBUG=true

# MySQL (async URL for SQLAlchemy + aiomysql)
DATABASE_URL=mysql+aiomysql://user:password@127.0.0.1:3306/resume_analyzer

# OpenAI (embeddings + chat)
OPENAI_API_KEY=sk-...

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=resume-analyzer
# Optional: serverless region/host if required by your SDK version
# PINECONE_ENVIRONMENT=

# Embeddings must match index dimension (e.g. text-embedding-3-small -> 1536)
EMBEDDING_MODEL=text-embedding-3-small
